# Community Edition — no subscription, payment account, or AI key needed.
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=data/community.sqlite
# Self-hosted production: set PUBLIC_URL=https://your-domain.example and NODE_ENV=production.
# BACKUP_DIRECTORY=/absolute/private/path/backups
# BACKUP_INTERVAL_MS=86400000
# REQUIRE_VERIFIED_EMAIL=1
# IDENTITY_EMAIL_BACKEND=resend
# IDENTITY_EMAIL_FROM=support@your-verified-domain.example
# IDENTITY_ALLOWED_FROM_DOMAIN=your-verified-domain.example
# RESEND_API_KEY=add-via-secret-manager-not-git
# Optional photorealistic remodeling is DISABLED; it requires separate provider and explicit photo consent.
# PHOTO_REMODEL_PROVIDER=openai
# PHOTO_REMODEL_PROCESSING_APPROVED=1
# PHOTO_REMODEL_OPENAI_KEY=add-via-secret-manager-not-git
# PHOTO_REMODEL_BUDGET_CENTS=100
